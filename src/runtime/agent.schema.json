{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codesoul-co.github.io/Ditto/agent.schema.json",
  "title": "Ditto Agent configuration",
  "description": "Structural validation. Use validateAgent for graph references, cycles and expression scopes; execution preflights host Worker bindings.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "graphs": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/graph"
      },
      "required": [
        "main"
      ]
    },
    "entry": {
      "const": "main"
    },
    "loop": {
      "$ref": "#/$defs/loop"
    },
    "config": {
      "$ref": "#/$defs/json"
    },
    "deployment": {
      "$ref": "#/$defs/deployment"
    }
  },
  "required": [
    "version",
    "id",
    "graphs"
  ],
  "additionalProperties": false,
  "not": {
    "required": [
      "entry",
      "loop"
    ]
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^(?!(?:__proto__|prototype|constructor)$)[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "referencePath": {
      "type": "string",
      "pattern": "^(?!(?:.*\\.)?(?:__proto__|prototype|constructor)(?:\\.|$))[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
    },
    "json": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "allOf": [
              {
                "not": {
                  "pattern": "^\\$"
                }
              },
              {
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              }
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/expression"
          }
        },
        {
          "type": "object",
          "properties": {
            "$literal": {
              "$ref": "#/$defs/json"
            }
          },
          "required": [
            "$literal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "$ref": {
              "$ref": "#/$defs/referencePath"
            },
            "default": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "$ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "$map": {
              "type": "object",
              "properties": {
                "items": {
                  "$ref": "#/$defs/expression"
                },
                "value": {
                  "$ref": "#/$defs/expression"
                }
              },
              "required": [
                "items",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "$map"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "$op": {
              "enum": [
                "not",
                "length",
                "first",
                "dropFirst",
                "isEmpty"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "$op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "$op": {
              "enum": [
                "eq",
                "ne",
                "lt",
                "lte",
                "gt",
                "gte",
                "add",
                "subtract",
                "and",
                "or",
                "at",
                "append",
                "concat",
                "merge"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "$op",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "dependsOn": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              },
              "uniqueItems": true
            },
            "input": {
              "$ref": "#/$defs/expression"
            },
            "kind": {
              "const": "node"
            },
            "type": {
              "type": "string",
              "pattern": "^[A-Za-z_][\\w-]*(?:\\.[A-Za-z_][\\w-]*)+$"
            },
            "require": {
              "type": "object",
              "properties": {
                "path": {
                  "$ref": "#/$defs/referencePath"
                },
                "equals": {
                  "$ref": "#/$defs/json"
                }
              },
              "required": [
                "path",
                "equals"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "type",
            "input"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "dependsOn": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              },
              "uniqueItems": true
            },
            "input": {
              "$ref": "#/$defs/expression"
            },
            "kind": {
              "const": "subgraph"
            },
            "graph": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "id",
            "kind",
            "graph",
            "input"
          ],
          "additionalProperties": false
        }
      ]
    },
    "graph": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "output": {
          "$ref": "#/$defs/expression"
        }
      },
      "required": [
        "nodes"
      ],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "graph": {
          "$ref": "#/$defs/identifier"
        },
        "input": {
          "$ref": "#/$defs/expression"
        },
        "assign": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/expression"
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "when": {
                "$ref": "#/$defs/expression"
              },
              "next": {
                "$ref": "#/$defs/identifier"
              },
              "end": {
                "$ref": "#/$defs/identifier"
              }
            },
            "required": [],
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "next"
                ],
                "not": {
                  "required": [
                    "end"
                  ]
                }
              },
              {
                "required": [
                  "end"
                ],
                "not": {
                  "required": [
                    "next"
                  ]
                }
              }
            ]
          }
        }
      },
      "required": [
        "graph",
        "input",
        "transitions"
      ],
      "additionalProperties": false
    },
    "loop": {
      "type": "object",
      "properties": {
        "entry": {
          "$ref": "#/$defs/identifier"
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": {
          "$ref": "#/$defs/expression"
        },
        "while": {
          "$ref": "#/$defs/expression"
        },
        "steps": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/step"
          },
          "minProperties": 1
        },
        "output": {
          "$ref": "#/$defs/expression"
        }
      },
      "required": [
        "entry",
        "maxIterations",
        "state",
        "steps"
      ],
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "properties": {
        "workers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "use": {
                "$ref": "#/$defs/identifier"
              },
              "services": {
                "$ref": "#/$defs/identifier"
              }
            },
            "required": [
              "id",
              "use"
            ],
            "additionalProperties": false
          }
        },
        "bindings": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
